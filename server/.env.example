# Copy this file to `.env` in the same folder and fill in real values.
# Never commit the real `.env` or your Firebase service account JSON.

# Razorpay (Settings → API Keys in the Razorpay dashboard). Start with Test keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase project this server talks to (must match the client's project).
FIREBASE_PROJECT_ID=winged-precinct-484016-f3

# EITHER put the downloaded service account file at server/firebase-service-account.json
# (default, gitignored) and leave the next line unset,
# OR paste the whole JSON as one line here (useful on hosts without file uploads):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

PORT=8080
